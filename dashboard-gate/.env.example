# Set these in the Netlify UI for Production only. Do not commit real values.
# Twilio Console → Account Info, and Verify → Services.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# E.164, Sri Lanka. These never go to the browser.
PHONE_SUDATHTHA=+94XXXXXXXXX
PHONE_SUBRAJA=+94XXXXXXXXX
PHONE_ZAINAB=+94XXXXXXXXX
# openssl rand -base64 32
SESSION_SECRET=
# Whole JSON key for a Google service account. Sheets API enabled.
# Share each stall response spreadsheet with the client_email as Viewer.
GOOGLE_SA_KEY_JSON=
# JSON object, one entry per stall. ids stay here, never in the repo.
# {"sri-lanka":{"id":"SHEET_ID","gid":0},"japan":{"id":"SHEET_ID","gid":0},"australia":{"id":"SHEET_ID","gid":0},"sea":{"id":"SHEET_ID","gid":0},"india":{"id":"SHEET_ID","gid":0},"americas":{"id":"SHEET_ID","gid":0},"europe":{"id":"SHEET_ID","gid":0},"middle-east":{"id":"SHEET_ID","gid":0},"china":{"id":"SHEET_ID","gid":0},"maldives":{"id":"SHEET_ID","gid":0},"un-zone":{"id":"SHEET_ID","gid":0}}
STALL_SHEETS=
